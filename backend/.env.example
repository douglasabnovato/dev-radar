# Copie para .env (nunca versione o .env)
# MongoDB Atlas: Database > Connect > Drivers. Use um usuário só deste app, com senha forte.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/devradar?retryWrites=true&w=majority
PORT=3333
# Origem do front (ex.: https://devradar.vercel.app); * libera todas
CORS_ORIGIN=*
SEARCH_RADIUS_METERS=10000
